ow"},{"_meta":{"bareName":"design","path":"/home/user/bundled/skills/design/SKILL.md","qualifiedName":"bundled:design","scope":"bundled"},"description":"Run the full design-doc-writer and design-doc-reviewer loop until consensus. Produces a polished design document with a PR plan.","input":{"hint":"<description of what to design> [--publish]"},"name":"design"},{"_meta":{"bareName":"execute-plan","path":"/home/user/bundled/skills/execute-plan/SKILL.md","qualifiedName":"bundled:execute-plan","scope":"bundled"},"description":"Execute a PR Plan DAG from a design document. Parses the plan, topologically sorts it, implements PRs in parallel using worktree-isolated subagents, runs mandatory orchestrator-level review, and assembles either a Graphite PR stack or a plain-git branch stack depending on tool availability.","input":{"hint":"<design-doc-path> [--effort N] [--concurrency N] [--dry-run] [--resume <PLAN_ID>] [--instructions \"...\"] [--no-graphite] [--auto-pr]"},"name":"execute-plan"},{"_meta":{"bareName":"game-assets","path":"/home/user/bundled/skills/game-assets/SKILL.md","qualifiedName":"bundled:game-assets","scope":"bundled"},"description":"Engine-ready game art, 2D sprites to 3D models","input":null,"name":"game-assets"},{"_meta":{"bareName":"imagine","path":"/home/user/bundled/skills/imagine/SKILL.md","qualifiedName":"bundled:imagine","scope":"bundled"},"description":"Prompting and workflow guidance for Imagine image and video tools","input":null,"name":"bundled:imagine"},{"_meta":{"bareName":"implement","path":"/home/user/bundled/skills/implement/SKILL.md","qualifiedName":"bundled:implement","scope":"bundled"},"description":"Run the full implement-review-fix loop using implementer and reviewer personas. Supports effort-based multi-reviewer scaling (2–7 reviewers) with automatic specialization selection. Includes memory-based feedback loop that learns from past review patterns. Loops until all reviewers find 0 issues of any severity.","input":{"hint":"[--effort N] <description of what to implement>"},"name":"implement"},{"_meta":{"bareName":"learn","path":"/home/user/bundled/skills/learn/SKILL.md","qualifiedName":"bundled:learn","scope":"bundled"},"description":"Learn from your own Grok Build sessions and tune your setup: add skills for things you keep typing, fix stale skill instructions, and retire skills, plugins, or MCP servers you never use. Use on \"/learn\", \"learn from my traces\", \"what skills do I never use\". Not for summarizing sessions into notes or memory.","input":{"hint":"[--mode step|auto|report] [--days N | --since-last | --limit N] [--per-trace] [--include-headless] [--cwd PATH] [--focus TEXT] [--resume]"},"name":"learn"},{"_meta":{"bareName":"long-running-background-tasks","path":"/home/user/bundled/skills/long-running-background-tasks/SKILL.md","qualifiedName":"bundled:long-running-background-tasks","scope":"bundled"},"description":"Required reading before you start, watch, or wait on anything that keeps running after you launch it — background jobs, watchers, scheduled loops, CI, pull requests, training runs, dev servers, long builds. Read it before you launch such work and before you report on its state. Saying where a running job stands counts as working on it. Use when: about to launch, supervise, inspect, diagnose, or report on work that keeps running after it is started.","input":null,"name":"long-running-background-tasks"},{"_meta":{"bareName":"pr-babysit","path":"/home/user/bundled/skills/pr-babysit/SKILL.md","qualifiedName":"bundled:pr-babysit","scope":"bundled"},"description":"Monitor PRs, fix CI failures, address review comments (human and bot/automated), resolve merge conflicts, and restack stacks. Supports independent PRs, Graphite stacks, and GitHub stacked PRs (gh-stack). Optional ship lands a ready PR bottom-up when every job has passed and no comments remain open.","input":{"hint":"add [--ship] <number> | remove <number> | list | check | ship [on|off] [number...]"},"name":"pr-babysit"},{"_meta":{"bareName":"resume-claude","path":"/home/user/bundled/skills/resume-claude/SKILL.md","qualifiedName":"bundled:resume-claude","scope":"bundled"},"description":"Continue from a recent Claude Code session","input":{"hint":"[words describing the session | session id]"},"name":"resume-claude"},{"_meta":{"bareName":"resume-codex","path":"/home/user/bundled/skills/resume-codex/SKILL.md","qualifiedName":"bundled:resume-codex","scope":"bundled"},"description":"Continue from a recent Codex session","input":{"hint":"[words describing the session | session id]"},"name":"resume-codex"},{"_meta":{"bareName":"resume-cursor","path":"/home/user/bundled/skills/resume-cursor/SKILL.md","qualifiedName":"bundled:resume-cursor","scope":"bundled"},"description":"Continue from a recent Cursor session","input":{"hint":"[words describing the session | session id]"},"name":"resume-cursor"},{"_meta":{"bareName":"review","path":"/home/user/bundled/skills/review/SKILL.md","qualifiedName":"bundled:review","scope":"bundled"},"description":"Run a reviewer subagent against your whole branch vs main, your uncommitted working state, a named branch, a single GitHub PR, or an entire Graphite/stacked-PR stack (one reviewer subagent per PR). A bare /review defaults to reviewing your uncommitted working state when the tree is dirty, or your whole branch vs main when the tree is clean. Main, local, and branch modes write a review file plus a summary to disk. PR and stack modes post the findings as a PENDING GitHub review for the user to inspect and submit through the UI. Use --main for an explicit clean-tree branch review, --stack for stacked PRs, --submit to publish immediately as COMMENT, or --approve to publish and approve; the default remains PENDING.","input":{"hint":"[--main | --local | --branch <name> | --pr <number-or-url> | --stack <number-or-url> | <auto-detect>] [--approve | --submit]"},"name":"review"},{"_meta":{"bareName":"skill-design-principles","path":"/home/user/bundled/skills/